{
  "name": "@huygens/mcp",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "MCP_PORT=3030 bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test --timeout 20000 test/",
    "db:apply": "bun run scripts/apply-schema.ts",
    "db:define-reader": "bun run scripts/define-reader.ts",
    "db:smoke": "bun run scripts/smoke.ts",
    "db:reindex": "bun run scripts/reindex.ts",
    "db:rebuild": "bun run scripts/rebuild-graph.ts",
    "db:verify-fold": "bun run scripts/verify-fold.ts",
    "db:genesis": "bun run scripts/genesis.ts",
    "db:backfill-kind": "bun run scripts/backfill-block-kind.ts",
    "db:migrate-saved-queries": "bun run scripts/migrate-saved-queries-temporal.ts"
  },
  "dependencies": {
    "@huygens/graph": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "surrealdb": "^2.0.3",
    "uuidv7": "^1.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.3"
  }
}
