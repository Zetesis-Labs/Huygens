{
  "name": "@huygens/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "MCP_PORT=3030 bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.3"
  }
}
