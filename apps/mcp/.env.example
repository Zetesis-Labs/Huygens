DEEPINFRA_API_KEY=
OPENAI_API_KEY=

# Password for the SurrealMCP read-only database user.
# Generate with: openssl rand -base64 24
# Use the same generated value for both names:
# - SURREAL_READER_PASS is read by `bun run db:define-reader`
# - SURREALDB_PASS is read by the upstream surrealmcp container
SURREAL_READER_PASS=
SURREALDB_PASS=
