---
import ChangeGraph from '../components/ChangeGraph.tsx'
import DateRangePicker from '../components/DateRangePicker.tsx'
import Markdown from '../components/Markdown.tsx'
import { buildBitacora } from '../lib/bitacoraView'
import { buildDayView, buildRangeView, listDiaryDays } from '../lib/diaryView'
import { buildMitView } from '../lib/mitView'
import { buildProposalView } from '../lib/proposalView'
import { listInbox, listMits, listProposals, todayMadridDay } from '../lib/surreal'

// Unified workspace: a single left panel with three nav sections (Inbox, Diario,
// Proposals) and a main canvas. Inbox is a placeholder for now. Proposals lists
// every proposal; selecting one renders its change graph. Diario lists the days
// changes landed; selecting one renders the *aggregated* graph of everything
// committed that day. The selection travels in the URL (?proposal=<id> or
// ?day=<YYYY-MM-DD>) so the whole view is server-rendered and deep-linkable.
const params = Astro.url.searchParams
const mitsView = params.get('view') === 'mits'
const bitacoraView = params.get('view') === 'bitacora'
const inboxView = params.get('view') === 'inbox'
const selectedDay = mitsView || bitacoraView || inboxView ? null : params.get('day')
const from = params.get('from')
const to = params.get('to')
const rangeMode = !mitsView && !bitacoraView && !inboxView && !selectedDay && Boolean(from && to)
const selectedId = mitsView || bitacoraView || inboxView || selectedDay || rangeMode ? null : params.get('proposal')

let proposals = [] as Awaited<ReturnType<typeof listProposals>>
let listError: string | null = null
try {
  proposals = await listProposals()
} catch (e) {
  listError = e instanceof Error ? e.message : String(e)
}

let days = [] as Awaited<ReturnType<typeof listDiaryDays>>
try {
  days = await listDiaryDays()
} catch {
  /* best-effort diary list */
}

// MITs (Most Important Tasks): today's are the focus; the rest go under "otros días".
// Madrid day = server clock + 2h, matching the diary's bucketing.
let mits = [] as Awaited<ReturnType<typeof listMits>>
try {
  mits = await listMits()
} catch {
  /* best-effort MIT panel */
}
const todayMadrid = todayMadridDay()
const todayMits = mits.filter(m => m.day === todayMadrid)

// Inbox: pending raw_captures, loaded only when the Inbox view is open.
let inbox = [] as Awaited<ReturnType<typeof listInbox>>
let inboxCount = 0
try {
  inbox = await listInbox()
  inboxCount = inbox.length
} catch {
  /* best-effort inbox */
}
const MIT_STATE_COLOR: Record<string, string> = {
  ACTIVE: '#2e7d32',
  CLARIFIED: '#5b6b8c',
  WAITING: '#9a7d0a',
  SOMEDAY: '#8a93a6',
  DONE: '#9aa3b2',
  ARCHIVED: '#c3cbe0'
}

let proposalView: Awaited<ReturnType<typeof buildProposalView>> | null = null
let dayView: Awaited<ReturnType<typeof buildDayView>> = null
let rangeView: Awaited<ReturnType<typeof buildRangeView>> = null
let mitView: Awaited<ReturnType<typeof buildMitView>> = null
let bitacora: Awaited<ReturnType<typeof buildBitacora>> = []
let viewError: string | null = null
try {
  if (bitacoraView) bitacora = await buildBitacora()
  else if (mitsView) mitView = await buildMitView(todayMadrid)
  else if (selectedId) proposalView = await buildProposalView(selectedId)
  else if (selectedDay) dayView = await buildDayView(selectedDay)
  else if (rangeMode && from && to) rangeView = await buildRangeView(from, to)
} catch (e) {
  viewError = e instanceof Error ? e.message : String(e)
}

const STATUS_COLOR: Record<string, string> = {
  draft: '#9a7d0a',
  committed: '#2e7d32',
  discarded: '#8a93a6',
  superseded: '#5b6b8c'
}

// Diary badge for planning/review informes (Bitácora kinds).
const KIND_BADGE: Record<string, string> = {
  plan_day: '🎯',
  review_day: '🔄',
  plan_week: '🗓️',
  review_week: '🔁'
}

// Diary nav: which committed day a selected proposal belongs to (to auto-expand
// it), and the draft proposals that live outside any committed day (Borradores).
const selectedProposalDay = selectedId ? (days.find(d => d.proposals.some(p => p.id === selectedId))?.day ?? null) : null
const diarioOpen = Boolean(selectedDay || selectedProposalDay)
const drafts = proposals.filter(p => p.status === 'draft')
const draftsOpen = Boolean(selectedId && !selectedProposalDay && drafts.some(p => p.id === selectedId))

const laidOut = proposalView?.laidOut ?? dayView?.laidOut ?? rangeView?.laidOut ?? mitView?.laidOut ?? null
const hasGraph = Boolean(proposalView?.proposal || dayView || rangeView || mitView)
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Huygens</title>
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body { font-family: system-ui, sans-serif; margin: 0; background: #fafbfc; color: #1f2530; height: 100vh; overflow: hidden; display: flex; }

      /* ---- left panel (panel único) ---- */
      .side { width: 280px; flex: 0 0 280px; border-right: 1px solid #e6e8eb; background: #fff; display: flex; flex-direction: column; min-height: 0; }
      .brand { padding: 16px 18px; border-bottom: 1px solid #eef0f2; font-size: 14px; font-weight: 700; letter-spacing: .02em; }
      .nav { padding: 8px; overflow-y: auto; min-height: 0; }

      .nav-item { width: 100%; display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: none; background: transparent; border-radius: 9px; cursor: pointer; font: inherit; font-size: 14px; color: #2a3346; text-align: left; }
      .nav-item:hover { background: #f4f6fb; }
      .nav-item.on { background: #eef1ff; color: #2f54eb; font-weight: 600; }
      .nav-item .icon { font-size: 16px; line-height: 1; }
      .nav-item .chev { margin-left: auto; font-size: 11px; color: #9aa3b2; transition: transform .2s ease; }
      .nav-item.open .chev { transform: rotate(90deg); }
      .nav-item.disabled { color: #aab2c0; cursor: default; }
      .nav-item.disabled:hover { background: transparent; }
      .nav-item .soon { margin-left: auto; font-size: 10px; text-transform: uppercase; letter-spacing: .04em; color: #b8c0cd; }

      /* ---- accordion drawers (the animated reveal) ---- */
      .drawer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .28s ease; }
      .drawer.open { grid-template-rows: 1fr; }
      .drawer > .inner { overflow: hidden; min-height: 0; }
      .drawer-pad { padding: 4px 4px 8px 4px; }

      .item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px; margin: 2px 0; text-decoration: none; color: inherit; opacity: 0; transform: translateY(-4px); animation: slidein .26s ease forwards; }
      .drawer:not(.open) .item { animation: none; opacity: 0; }
      @keyframes slidein { to { opacity: 1; transform: translateY(0); } }
      .item:hover { background: #f4f6fb; }
      .item.active { background: #eef1ff; }
      .badge { font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 999px; color: #fff; flex: 0 0 auto; }
      .item .info { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
      .item .title { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .item .meta { font-size: 11px; color: #9aa3b2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .count { margin-left: auto; font-size: 11px; font-weight: 600; color: #6b7280; background: #f0f2f5; border-radius: 999px; padding: 1px 8px; flex: 0 0 auto; }
      .drawer .empty, .drawer .err { padding: 8px 12px; font-size: 12px; color: #6b7280; }
      .drawer .err { color: #b91c1c; }

      /* ---- main canvas + informe ---- */
      .main { flex: 1; min-width: 0; display: flex; min-height: 0; }
      .canvas { flex: 1; min-width: 0; position: relative; }
      .canvas > astro-island { position: absolute; inset: 0; }
      .placeholder { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #9aa3b2; font-size: 14px; padding: 24px; text-align: center; }
      .placeholder.err { color: #b91c1c; font-family: ui-monospace, monospace; white-space: pre-wrap; }
      .inbox { padding: 20px 24px; max-width: 760px; margin: 0 auto; width: 100%; overflow-y: auto; }
      .inbox-head { font-size: 14px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .04em; margin: 0 0 14px; }
      .inbox-item { border: 1px solid #e7e9ee; border-left: 3px solid #5b6b8c; border-radius: 8px; padding: 10px 14px; margin-bottom: 8px; background: #fff; }
      .inbox-meta { font-size: 11px; color: #9aa3b2; margin-bottom: 4px; }
      .inbox-content { font-size: 14px; color: #2a3346; white-space: pre-wrap; word-break: break-word; }
      .informe { width: 360px; flex: 0 0 360px; border-left: 1px solid #e6e8eb; background: #fff; overflow: auto; padding: 18px 20px; }
      .informe h2 { margin: 0 0 10px; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: #6b7280; }
      .informe .head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
      .informe .head h1 { margin: 0; font-size: 13px; font-family: ui-monospace, monospace; word-break: break-all; }
      .narrative { font-size: 14px; line-height: 1.55; margin: 0 0 16px; padding-bottom: 12px; border-bottom: 1px solid #f1f3f6; }
      .narrative > :first-child { margin-top: 0; }
      .narrative > :last-child { margin-bottom: 0; }
      .narrative h1, .narrative h2, .narrative h3 { font-size: 14px; font-weight: 700; margin: 12px 0 6px; color: #2a3346; }
      .narrative p { margin: 0 0 8px; }
      .narrative ul, .narrative ol { margin: 0 0 8px; padding-left: 20px; }
      .narrative li { margin: 2px 0; }
      .narrative code { background: #f1f3f6; padding: 1px 5px; border-radius: 4px; font-family: ui-monospace, monospace; font-size: 12px; }
      .narrative a { color: #2f54eb; }

      /* ---- Bitácora (lector cronológico de planes/reviews) ---- */
      .bitacora { position: absolute; inset: 0; overflow: auto; padding: 24px 28px; }
      .bitacora .bw { margin: 0 0 28px; }
      .bitacora .bw-head { position: sticky; top: 0; z-index: 1; margin: 0 0 12px; padding: 6px 0; font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: #6b7280; background: #fafbfc; }
      .bitacora .bd { margin: 0 0 16px; padding-left: 12px; border-left: 2px solid #eef0f2; }
      .bitacora .bd-head { margin: 0 0 8px; font-size: 13px; font-weight: 600; color: #2a3346; text-transform: capitalize; }
      .bitacora .binforme { background: #fff; border: 1px solid #e6e8eb; border-radius: 10px; padding: 12px 14px; margin: 0 0 10px; max-width: 760px; }
      .bitacora .bi-head { margin-bottom: 6px; }
      .bitacora .bi-kind { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; color: #2f54eb; }
      .bitacora .bi-body { font-size: 13.5px; line-height: 1.55; color: #1f2530; }
      .bitacora .bi-body > :first-child { margin-top: 0; }
      .bitacora .bi-body > :last-child { margin-bottom: 0; }
      .bitacora .bi-body h1, .bitacora .bi-body h2, .bitacora .bi-body h3 { font-size: 14px; font-weight: 700; margin: 14px 0 6px; color: #2a3346; }
      .bitacora .bi-body p { margin: 0 0 8px; }
      .bitacora .bi-body ul, .bitacora .bi-body ol { margin: 0 0 8px; padding-left: 20px; }
      .bitacora .bi-body li { margin: 2px 0; }
      .bitacora .bi-body code { background: #f1f3f6; padding: 1px 5px; border-radius: 4px; font-family: ui-monospace, monospace; font-size: 12px; }
      .bitacora .bi-body strong { font-weight: 700; }
      .bitacora .bi-body a { color: #2f54eb; }
      .kind-chip { flex: 0 0 auto; font-size: 12px; line-height: 1; margin-right: 2px; }
      .narrative:last-of-type { border-bottom: none; }
      .counts { display: flex; flex-wrap: wrap; gap: 8px; border-top: 1px solid #eef0f2; padding-top: 14px; }
      .chip { font-size: 12px; background: #f4f4f6; border-radius: 999px; padding: 3px 10px; color: #3a4252; }

      /* ---- diario: día = link al agregado; el número de proposals es el botón
             que despliega la lista (al hover/abierto el número muta a iconito) ---- */
      .day-group { margin: 1px 0; }
      .day-row { display: flex; align-items: center; border-radius: 8px; }
      .day-row:hover { background: #f4f6fb; }
      .day-link { flex: 1; min-width: 0; display: flex; align-items: center; padding: 8px 10px; text-decoration: none; color: #2a3346; }
      .day-row.on .day-link { color: #2f54eb; }
      .day-link .title { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .day-expand { flex: 0 0 auto; min-width: 30px; height: 24px; margin-right: 6px; display: inline-flex; align-items: center; justify-content: center; border: none; background: #f0f2f5; color: #6b7280; border-radius: 999px; font: inherit; font-size: 11px; font-weight: 600; cursor: pointer; padding: 0 9px; }
      .day-expand:hover { background: #e2e8f8; color: #2f54eb; }
      .day-expand .exp-icon { display: none; font-size: 11px; line-height: 1; transition: transform .2s ease; }
      .day-expand:hover .num, .day-expand.open .num { display: none; }
      .day-expand:hover .exp-icon, .day-expand.open .exp-icon { display: inline; }
      .day-expand.open .exp-icon { transform: rotate(90deg); }
      .day-sub { padding-left: 16px; }
      .item.sub { padding: 6px 10px; }
      .item.sub .title { font-size: 12.5px; font-weight: 500; }

      /* ---- MITs panel (foco del día, encima del Diario) ---- */
      .mit-panel { padding: 4px 4px 8px; margin-bottom: 4px; border-bottom: 1px solid #eef0f2; }
      .mit-head { display: flex; align-items: center; gap: 6px; padding: 4px 8px 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #6b7280; }
      .mit-empty { margin: 0; padding: 2px 10px 4px; font-size: 12px; color: #9aa3b2; }
      .mit-item { display: flex; align-items: flex-start; gap: 8px; padding: 6px 10px; border-radius: 8px; }
      .mit-item:hover { background: #f4f6fb; }
      .mit-state { flex: 0 0 auto; margin-top: 1px; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; padding: 2px 6px; border-radius: 999px; color: #fff; }
      .mit-info { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
      .mit-title { font-size: 13px; font-weight: 600; color: #2a3346; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .mit-parent { font-size: 11px; color: #9aa3b2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .mit-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px; }
      .mit-tag { font-size: 10px; font-weight: 600; padding: 1px 6px; border-radius: 999px; white-space: nowrap; }
      .mit-tag.due { background: #fef3c7; color: #92400e; }
      .mit-tag.due-over { background: #fee2e2; color: #b91c1c; }
      .mit-tag.defer { background: #e0e7ff; color: #3730a3; }
      .mit-more { width: 100%; display: flex; align-items: center; gap: 6px; padding: 5px 10px; border: none; background: transparent; cursor: pointer; font: inherit; font-size: 11px; color: #6b7280; }
      .mit-more:hover { color: #2f54eb; }
      .mit-more .chev { font-size: 10px; transition: transform .2s ease; }
      .mit-more.open .chev { transform: rotate(90deg); }
    </style>

    <style is:global>
      /* ---- Date review: trigger (fila del nav) + calendario de rango doble-mes (isla React) ---- */
      .cal-trigger { width: 100%; display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: none; background: transparent; border-radius: 9px; cursor: pointer; font: inherit; font-size: 14px; color: #2a3346; text-align: left; }
      .cal-trigger:hover { background: #f4f6fb; }
      .cal-trigger.on { background: #eef1ff; color: #2f54eb; font-weight: 600; }
      .cal-tic { font-size: 16px; line-height: 1; }
      .cal-chev { margin-left: auto; font-size: 11px; color: #9aa3b2; }
      .cal-tag { margin-left: auto; font-size: 11px; font-weight: 600; color: #2f54eb; background: #fff; border: 1px solid #d6deff; border-radius: 999px; padding: 1px 8px; }

      .cal-backdrop { position: fixed; inset: 0; background: rgba(20,26,38,.28); z-index: 1000; display: flex; align-items: flex-start; justify-content: center; padding-top: 72px; }
      .cal-pop { background: #fff; border-radius: 14px; box-shadow: 0 18px 48px rgba(20,26,38,.28); padding: 16px 18px 14px; width: 640px; max-width: calc(100vw - 32px); }
      .cal-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
      .cal-titles { flex: 1; display: flex; }
      .cal-mtitle { flex: 1; text-align: center; font-size: 14px; font-weight: 700; text-transform: capitalize; color: #1f2530; }
      .cal-arrow { width: 30px; height: 30px; border: 1px solid #e6e8eb; background: #fff; border-radius: 8px; cursor: pointer; font-size: 16px; line-height: 1; color: #3a4252; }
      .cal-arrow:hover { background: #f4f6fb; }

      .cal-months { display: flex; gap: 22px; }
      .cal-month { flex: 1; }
      .cal-week, .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
      .cal-wd { text-align: center; font-size: 11px; font-weight: 600; color: #9aa3b2; padding-bottom: 4px; }
      .cal-cell { position: relative; aspect-ratio: 1 / 1; border: none; background: transparent; border-radius: 8px; cursor: pointer; font: inherit; font-size: 13px; color: #2a3346; display: flex; align-items: center; justify-content: center; }
      .cal-cell.pad { visibility: hidden; cursor: default; }
      .cal-cell:hover { background: #eef1ff; }
      .cal-cell.in { background: #e7ecff; border-radius: 0; }
      .cal-cell.end { background: #2f54eb; color: #fff; border-radius: 8px; }
      .cal-cell.has { font-weight: 700; }
      .cal-dot { position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); width: 4px; height: 4px; border-radius: 999px; background: #2f54eb; }
      .cal-cell.end .cal-dot { background: #fff; }

      .cal-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12px; padding-top: 12px; border-top: 1px solid #eef0f2; }
      .cal-range { font-size: 13px; color: #3a4252; }
      .cal-actions { display: flex; gap: 8px; }
      .cal-btn { border: none; background: #2f54eb; color: #fff; border-radius: 8px; padding: 7px 16px; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none; }
      .cal-btn:hover { background: #2647d4; }
      .cal-btn:disabled { background: #c3cbe0; cursor: default; }
      .cal-btn.ghost { background: #f0f2f5; color: #3a4252; }
      .cal-btn.ghost:hover { background: #e6e9ef; }

      /* ---- Responsive / mobile ---- */
      /* The hamburger + backdrop exist only on small screens. */
      .menu-toggle { display: none; }
      .nav-backdrop { display: none; }
      .view-toggle { display: none; }
      @media (max-width: 820px) {
        /* Graph views: a segmented toggle to collapse to graph-only or informe-only. */
        .view-toggle {
          display: inline-flex; position: fixed; top: 10px; right: 10px; z-index: 1200;
          background: #fff; border: 1px solid #e6e8eb; border-radius: 10px; overflow: hidden;
          box-shadow: 0 1px 6px rgba(0,0,0,.14);
        }
        .vt-btn { border: none; background: transparent; padding: 8px 11px; font: inherit; font-size: 12px; font-weight: 600; color: #6b7280; cursor: pointer; }
        .vt-btn + .vt-btn { border-left: 1px solid #eef0f2; }
        .vt-btn.on { background: #2f54eb; color: #fff; }
        body.m-only-graph .informe { display: none; }
        body.m-only-informe .canvas { display: none; }
        body.m-only-informe .informe { max-height: none; flex: 1 1 auto; border-top: none; }
        .menu-toggle {
          display: flex; position: fixed; top: 10px; left: 10px; z-index: 1200;
          width: 42px; height: 42px; align-items: center; justify-content: center;
          background: #fff; border: 1px solid #e6e8eb; border-radius: 10px;
          box-shadow: 0 1px 6px rgba(0,0,0,.14); cursor: pointer; font-size: 20px; line-height: 1; color: #2a3346;
        }
        /* Nav becomes an off-canvas drawer slid in from the left. */
        .side {
          position: fixed; top: 0; left: 0; height: 100vh; z-index: 1100;
          width: 86vw; max-width: 320px; flex-basis: auto;
          transform: translateX(-100%); transition: transform .25s ease;
          box-shadow: 2px 0 16px rgba(0,0,0,.18);
        }
        body.nav-open .side { transform: translateX(0); }
        body.nav-open .nav-backdrop {
          display: block; position: fixed; inset: 0; z-index: 1050; background: rgba(20,26,38,.32);
        }
        /* Canvas and informe stack vertically; each scrolls on its own. */
        .main { flex-direction: column; }
        .canvas { flex: 1 1 0; min-height: 0; }
        .informe {
          width: 100%; flex: 0 0 auto; max-height: 46vh;
          border-left: none; border-top: 1px solid #e6e8eb;
        }
        /* keep headings clear of the floating hamburger */
        .inbox, .bitacora { padding-top: 58px; }
        .inbox { padding-left: 14px; padding-right: 14px; }
      }
    </style>
  </head>
  <body>
    <button class="menu-toggle" type="button" aria-label="Abrir menú" data-nav-toggle>☰</button>
    <div class="nav-backdrop" data-nav-backdrop></div>
    {hasGraph && (
      <div class="view-toggle" role="group" aria-label="Vista">
        <button type="button" class="vt-btn on" data-view="split">Dividir</button>
        <button type="button" class="vt-btn" data-view="graph">Grafo</button>
        <button type="button" class="vt-btn" data-view="informe">Informe</button>
      </div>
    )}
    <nav class="side">
      <div class="brand">Huygens</div>
      <div class="nav">
        <!-- Inbox: raw_captures pendientes de procesar (/?view=inbox) -->
        <a class={`nav-item ${inboxView ? 'on' : ''}`} href="/?view=inbox">
          <span class="icon">📥</span><span>Inbox</span>
          {inboxCount > 0 && <span class="count">{inboxCount}</span>}
        </a>

        <!-- MITs: el foco del día → grafo en el canvas (/?view=mits) -->
        <a class={`nav-item ${mitsView ? 'on' : ''}`} href="/?view=mits">
          <span class="icon">🎯</span><span>MITs</span>
          {todayMits.length > 0 && <span class="count">{todayMits.length}</span>}
        </a>

        <!-- Bitácora: planes y revisiones (día/semana) leídos como hilo (/?view=bitacora) -->
        <a class={`nav-item ${bitacoraView ? 'on' : ''}`} href="/?view=bitacora">
          <span class="icon">📖</span><span>Bitácora</span>
        </a>

        <!-- Diario: días, cada uno desplegable a sus proposals committed -->
        <button class={`nav-item ${diarioOpen ? 'on open' : ''}`} type="button" data-toggle="diario">
          <span class="icon">📓</span><span>Diario</span><span class="chev">▸</span>
        </button>
        <div class={`drawer ${diarioOpen ? 'open' : ''}`} data-drawer="diario">
          <div class="inner">
            <div class="drawer-pad">
              {listError && <p class="err">No pude leer SurrealDB: {listError}</p>}
              {!listError && days.length === 0 && <p class="empty">Sin días con cambios.</p>}
              {days.map(d => {
                const dayOpen = d.day === selectedDay || d.day === selectedProposalDay
                return (
                  <div class="day-group">
                    <div class={`day-row ${d.day === selectedDay ? 'on' : ''}`}>
                      <a class="day-link" href={`/?day=${d.day}`}>
                        <span class="title">{d.label}</span>
                      </a>
                      <button
                        class={`day-expand ${dayOpen ? 'open' : ''}`}
                        type="button"
                        data-toggle={`day-${d.day}`}
                        title="Desplegar los proposals del día"
                        aria-label="Desplegar proposals del día"
                      >
                        <span class="num">{d.count}</span>
                        <span class="exp-icon">▸</span>
                      </button>
                    </div>
                    <div class={`drawer ${dayOpen ? 'open' : ''}`} data-drawer={`day-${d.day}`}>
                      <div class="inner">
                        <div class="day-sub">
                          {d.proposals.map(p => (
                            <a class={`item sub ${p.id === selectedId ? 'active' : ''}`} href={`/?proposal=${encodeURIComponent(p.id)}`} title={p.kind ? `${p.kind} · ${p.title}` : p.title}>
                              {p.kind && <span class="kind-chip" title={p.kind}>{KIND_BADGE[p.kind] ?? '📄'}</span>}
                              <span class="info"><span class="title">{p.title}</span></span>
                            </a>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                )
              })}
            </div>
          </div>
        </div>

        <!-- Date review: calendario de rango (popover). Filtro temporal; no sustituye al Diario. -->
        <DateRangePicker client:load daysWith={days} from={from} to={to} />

        {drafts.length > 0 && (
          <Fragment>
            <!-- Borradores: proposals sin commitear (viven fuera de cualquier día) -->
            <button class={`nav-item ${draftsOpen ? 'on open' : ''}`} type="button" data-toggle="drafts">
              <span class="icon">📝</span><span>Borradores</span><span class="count">{drafts.length}</span>
            </button>
            <div class={`drawer ${draftsOpen ? 'open' : ''}`} data-drawer="drafts">
              <div class="inner">
                <div class="drawer-pad">
                  {drafts.map(p => (
                    <a class={`item ${p.id === selectedId ? 'active' : ''}`} href={`/?proposal=${encodeURIComponent(p.id)}`} title={p.title}>
                      <span class="badge" style={`background:${STATUS_COLOR[p.status] ?? '#5b6b8c'}`}>{p.status}</span>
                      <span class="info">
                        <span class="title">{p.title}</span>
                        <span class="meta">{p.raw_count} raw · {new Date(p.created_at).toLocaleDateString('es-ES')}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </Fragment>
        )}
      </div>
    </nav>

    <div class="main">
      <div class="canvas">
        {viewError && <div class="placeholder err">Error: {viewError}</div>}
        {!viewError && !hasGraph && !bitacoraView && !inboxView && <div class="placeholder">Selecciona una proposal, un día del Diario o un rango (Date review).</div>}
        {!viewError && inboxView && inbox.length === 0 && (
          <div class="placeholder">Inbox vacío. Las capturas pendientes (raw_captures sin procesar) aparecerán aquí.</div>
        )}
        {!viewError && inboxView && inbox.length > 0 && (
          <article class="inbox">
            <h2 class="inbox-head">📥 Inbox · {inbox.length} pendiente{inbox.length > 1 ? 's' : ''}</h2>
            {inbox.map(r => (
              <div class="inbox-item">
                <div class="inbox-meta">{r.sourceKind} · {r.createdAt.slice(0, 16).replace('T', ' ')}</div>
                <div class="inbox-content">{r.content}</div>
              </div>
            ))}
          </article>
        )}
        {!viewError && bitacoraView && bitacora.length === 0 && (
          <div class="placeholder">Bitácora vacía. Los planes y cierres (rituales <code>plan_day</code> / <code>review_day</code>) aparecerán aquí en cuanto el agente los registre.</div>
        )}
        {!viewError && bitacoraView && bitacora.length > 0 && (
          <article class="bitacora">
            {bitacora.map(w => (
              <section class="bw">
                <h2 class="bw-head">{w.label}</h2>
                {w.days.map(d => (
                  <div class="bd">
                    <h3 class="bd-head">{d.label}</h3>
                    {d.entries.map(e => (
                      <div class="binforme">
                        <div class="bi-head">
                          <span class="bi-kind">{e.kindIcon} {e.kindLabel}</span>
                        </div>
                        <div class="bi-body"><Markdown content={e.content} /></div>
                      </div>
                    ))}
                  </div>
                ))}
              </section>
            ))}
          </article>
        )}
        {!viewError && selectedId && !proposalView?.proposal && <div class="placeholder">Proposal no encontrada.</div>}
        {!viewError && selectedDay && !dayView && <div class="placeholder">Sin cambios ese día.</div>}
        {!viewError && rangeMode && !rangeView && <div class="placeholder">Sin cambios en ese rango.</div>}
        {!viewError && mitsView && !mitView && (
          <div class="placeholder">Sin MITs para hoy. Márcalos con el agente (vía proposal) y aparecerán aquí.</div>
        )}
        {!viewError && proposalView?.legacy && (
          <div class="placeholder">Proposal aplanada en el génesis (formato legacy) — sin grafo. El informe está a la derecha.</div>
        )}
        {!viewError && hasGraph && laidOut && !proposalView?.legacy && (
          <ChangeGraph client:only="react" nodes={laidOut.nodes} edges={laidOut.edges} />
        )}
      </div>

      {!viewError && proposalView?.proposal && (
        <aside class="informe">
          <div class="head">
            <span class="badge" style={`background:${STATUS_COLOR[proposalView.proposal.status] ?? '#5b6b8c'}`}>{proposalView.proposal.status}</span>
            <h1>{proposalView.proposal.id}</h1>
          </div>
          <h2>Informe</h2>
          {proposalView.narratives.map(n => <div class="narrative"><Markdown content={n} /></div>)}
          {proposalView.counts && (
            <div class="counts">
              <span
                class="chip"
                title={
                  proposalView.historical
                    ? 'contexto reconstruido al instante del commit (fold del SSOT)'
                    : 'contexto en vivo (estado actual del grafo)'
                }
              >
                {proposalView.historical ? '🕓 contexto del commit' : '⟳ contexto actual'}
              </span>
              <span class="chip">{proposalView.counts.raws} raw</span>
              <span class="chip">+{proposalView.counts.creates} notas</span>
              <span class="chip">{proposalView.counts.updates} updates</span>
              <span class="chip">{proposalView.counts.edges} edges</span>
            </div>
          )}
        </aside>
      )}

      {!viewError && dayView && (
        <aside class="informe">
          <div class="head">
            <span class="icon" style="font-size:18px">📓</span>
            <h1>{dayView.label}</h1>
            <span class="count">{dayView.counts.proposals} proposals</span>
          </div>
          <h2>Cambios del día</h2>
          {dayView.narratives.map(n => <div class="narrative"><Markdown content={n} /></div>)}
          <div class="counts">
            <span class="chip" title="relaciones pre-existentes hidratadas en vivo">⟳ contexto actual</span>
            <span class="chip">{dayView.counts.raws} raw</span>
            <span class="chip">+{dayView.counts.creates} notas</span>
            <span class="chip">{dayView.counts.updates} updates</span>
            <span class="chip">{dayView.counts.edges} edges</span>
          </div>
        </aside>
      )}

      {!viewError && rangeView && (
        <aside class="informe">
          <div class="head">
            <span class="icon" style="font-size:18px">📅</span>
            <h1>{rangeView.label}</h1>
            <span class="count">{rangeView.counts.proposals} proposals</span>
          </div>
          <h2>Cambios del rango</h2>
          {rangeView.narratives.map(n => <div class="narrative"><Markdown content={n} /></div>)}
          <div class="counts">
            <span class="chip" title="relaciones pre-existentes hidratadas en vivo">⟳ contexto actual</span>
            <span class="chip">{rangeView.counts.raws} raw</span>
            <span class="chip">+{rangeView.counts.creates} notas</span>
            <span class="chip">{rangeView.counts.updates} updates</span>
            <span class="chip">{rangeView.counts.edges} edges</span>
          </div>
        </aside>
      )}

      {!viewError && mitView && (
        <aside class="informe">
          <div class="head">
            <span class="icon" style="font-size:18px">🎯</span>
            <h1>MITs · hoy</h1>
            <span class="count">{mitView.mits.length}</span>
          </div>
          <h2>Foco del día</h2>
          {mitView.mits.map(m => (
            <div class="mit-item" title={m.day !== mitView.date ? `${m.title} · vencido ${m.day}` : m.title}>
              <span
                class="mit-state"
                style={`background:${m.day !== mitView.date ? '#d97706' : (MIT_STATE_COLOR[m.state] ?? '#5b6b8c')}`}
              >
                {m.day !== mitView.date ? '⏰ vencido' : m.state}
              </span>
              <span class="mit-info">
                <span class="mit-title">{m.title}</span>
                {m.day !== mitView.date ? (
                  <span class="mit-parent">{m.day}{m.parent ? ` · ${m.parent}` : ''}</span>
                ) : (
                  m.parent && <span class="mit-parent">{m.parent}</span>
                )}
                {(m.dueDay || m.deferDay) && (
                  <span class="mit-tags">
                    {m.dueDay && (
                      <span class={`mit-tag ${m.dueDay < mitView.date ? 'due-over' : 'due'}`}>
                        {m.dueDay < mitView.date ? '🔴 vence' : '⏰ vence'} {m.dueDay}
                      </span>
                    )}
                    {m.deferDay && <span class="mit-tag defer">😴 hasta {m.deferDay}</span>}
                  </span>
                )}
              </span>
            </div>
          ))}
        </aside>
      )}
    </div>

    <script>
      // Each nav button toggles its own accordion drawer. Selection itself is SSR
      // navigation; the toggle is purely visual.
      for (const btn of document.querySelectorAll('[data-toggle]')) {
        const name = btn.getAttribute('data-toggle')
        const drawer = document.querySelector(`[data-drawer="${name}"]`)
        btn.addEventListener('click', () => {
          drawer?.classList.toggle('open')
          btn.classList.toggle('open')
          btn.classList.toggle('on')
        })
      }

      // Mobile: hamburger toggles the off-canvas nav; backdrop tap closes it.
      document.querySelector('[data-nav-toggle]')?.addEventListener('click', () => {
        document.body.classList.toggle('nav-open')
      })
      document.querySelector('[data-nav-backdrop]')?.addEventListener('click', () => {
        document.body.classList.remove('nav-open')
      })

      // Mobile: collapse the graph/informe split to one pane.
      const viewToggle = document.querySelector('.view-toggle')
      if (viewToggle) {
        const btns = viewToggle.querySelectorAll('[data-view]')
        for (const b of btns) {
          b.addEventListener('click', () => {
            const mode = b.getAttribute('data-view')
            document.body.classList.remove('m-only-graph', 'm-only-informe')
            if (mode === 'graph') document.body.classList.add('m-only-graph')
            if (mode === 'informe') document.body.classList.add('m-only-informe')
            for (const x of btns) x.classList.toggle('on', x === b)
          })
        }
      }
    </script>
  </body>
</html>
