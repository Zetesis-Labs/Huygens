---
import ChatApp from '../components/chat/ChatApp.tsx'
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Huygens · chat</title>
    <style is:global>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body { font-family: system-ui, sans-serif; margin: 0; background: #fafbfc; color: #1f2530; height: 100vh; overflow: hidden; }

      /* Two real columns: canvas (1fr) + chat (380px). The toggle is positioned
         absolutely (out of flow), so only canvas + aside auto-place into the grid. */
      .chat-layout { display: grid; grid-template-columns: 1fr 380px; height: 100vh; transition: grid-template-columns .15s ease; }
      .chat-layout.collapsed { grid-template-columns: 1fr 0; }

      .chat-canvas { position: relative; min-width: 0; overflow: hidden; border-right: 1px solid #e6e8eb; }
      .canvas-msg { padding: 28px; color: #6b7280; font-size: 14px; }
      .canvas-msg.err { color: #b91c1c; font-family: ui-monospace, monospace; white-space: pre-wrap; }

      .view-selector { position: absolute; top: 0; left: 0; right: 0; z-index: 5; display: flex; gap: 6px; flex-wrap: wrap; padding: 8px 10px; background: rgba(250,251,252,.92); border-bottom: 1px solid #eef0f2; }
      .view-selector button { font-size: 12px; padding: 3px 10px; border: 1px solid #d6dae0; background: #fff; color: #4a5567; border-radius: 999px; cursor: pointer; }
      .view-selector button.on { border-color: #2f54eb; background: #eef1ff; color: #2f54eb; }

      .chat-toggle { position: relative; z-index: 6; width: 0; border: none; background: transparent; cursor: pointer; }
      .chat-layout .chat-toggle { position: absolute; top: 10px; right: 388px; width: 26px; height: 26px; border-radius: 6px; border: 1px solid #d6dae0; background: #fff; color: #4a5567; line-height: 1; transition: right .15s ease; }
      .chat-layout.collapsed .chat-toggle { right: 10px; }

      .chat-side { min-width: 0; background: #fff; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

      .thread { display: flex; flex-direction: column; height: 100%; min-height: 0; }
      .thread-viewport { flex: 1; min-height: 0; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
      .msg { padding: 8px 12px; border-radius: 10px; font-size: 14px; line-height: 1.45; white-space: pre-wrap; word-break: break-word; }
      .msg.user { align-self: flex-end; background: #2f54eb; color: #fff; max-width: 85%; }
      .msg.assistant { align-self: flex-start; background: #f1f3f6; color: #1f2530; max-width: 90%; }

      .tool-chip { align-self: flex-start; font-size: 12px; color: #4a5567; background: #eef1ff; border: 1px solid #dfe4fb; border-radius: 8px; padding: 4px 10px; font-family: ui-monospace, monospace; }

      .save-bar { display: flex; align-items: center; gap: 8px; padding: 6px 12px; border-top: 1px solid #eef0f2; }
      .save-bar button { font-size: 12px; padding: 4px 10px; border: 1px solid #d6dae0; background: #fff; color: #4a5567; border-radius: 6px; cursor: pointer; }
      .save-status { font-size: 12px; color: #6b7280; }

      .composer { display: flex; gap: 8px; padding: 12px; border-top: 1px solid #eef0f2; }
      .composer-input { flex: 1; font-size: 14px; font-family: inherit; padding: 8px 10px; border: 1px solid #d6dae0; border-radius: 8px; resize: none; min-height: 38px; max-height: 160px; }
      .composer-send { font-size: 14px; padding: 8px 16px; border: 1px solid #2f54eb; background: #2f54eb; color: #fff; border-radius: 8px; cursor: pointer; }
    </style>
  </head>
  <body>
    <ChatApp client:only="react" />
  </body>
</html>
