---
import ChangeGraph from '../../components/ChangeGraph.tsx'
import { mergeExistingEdges, proposalToFlow } from '../../lib/graph'
import { type LaidOutGraph, layoutGraph } from '../../lib/layout'
import { existingEdgesAmong, getProposal, labelsAtVersion, resolveLabels } from '../../lib/surreal'
import { commitAnchor, edgeReader } from '../../lib/temporal'

const { id } = Astro.params
let proposal = null as Awaited<ReturnType<typeof getProposal>>
let laidOut: LaidOutGraph = { nodes: [], edges: [] }
let historical = false
let error: string | null = null
try {
  proposal = id ? await getProposal(id) : null
  if (proposal) {
    // A committed proposal with a commit anchor is rendered in its *exact
    // historical context*: labels via VERSION-by-id and pre-existing topology
    // via changefeed replay, both as of the commit. Drafts (and pre-migration
    // commits without a versionstamp) fall back to the live graph.
    const anchor = commitAnchor(proposal)
    historical = anchor != null
    const labels = anchor ? await labelsAtVersion(proposal, anchor.committedAt) : await resolveLabels(proposal)
    const flow = proposalToFlow(proposal, labels)
    const realIds = flow.nodes.map(n => n.id).filter(nid => nid.includes(':'))
    const existing = anchor
      ? await edgeReader().edgesAmongAt(realIds, anchor)
      : await existingEdgesAmong(realIds)
    laidOut = await layoutGraph(mergeExistingEdges(flow, existing))
  }
} catch (e) {
  error = e instanceof Error ? e.message : String(e)
}

const narratives = proposal?.payload.narrative_blocks.map(b => b.content) ?? []
const counts = proposal
  ? {
      creates: proposal.payload.note_creates.length,
      updates: proposal.payload.note_updates.length,
      edges: proposal.payload.edges.length,
      raws: proposal.payload.raw_ids.length
    }
  : null
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Huygens · {id}</title>
    <style>
      :root { color-scheme: light; }
      body { font-family: system-ui, sans-serif; margin: 0; background: #fafbfc; color: #1f2530; display: flex; flex-direction: column; height: 100vh; }
      header { padding: 14px 24px; border-bottom: 1px solid #e6e8eb; display: flex; align-items: center; gap: 12px; flex: 0 0 auto; }
      header a { color: #2f54eb; text-decoration: none; font-size: 14px; }
      h1 { margin: 0; font-size: 15px; font-family: ui-monospace, monospace; }
      .status { font-size: 12px; color: #6b7280; }
      .body { flex: 1; display: flex; min-height: 0; }
      .canvas { flex: 1; min-width: 0; position: relative; }
      /* the client:only island element is inline by default; make it fill the canvas */
      .canvas > astro-island { position: absolute; inset: 0; }
      .panel { width: 360px; flex: 0 0 360px; border-left: 1px solid #e6e8eb; background: #fff; overflow: auto; padding: 18px 20px; }
      .panel h2 { margin: 0 0 10px; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: #6b7280; }
      .narrative { font-size: 14px; line-height: 1.55; white-space: pre-wrap; margin: 0 0 16px; }
      .counts { display: flex; flex-wrap: wrap; gap: 8px; border-top: 1px solid #eef0f2; padding-top: 14px; }
      .chip { font-size: 12px; background: #f4f4f6; border-radius: 999px; padding: 3px 10px; color: #3a4252; }
      .err, .empty { padding: 24px; color: #b91c1c; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">← proposals</a>
      <h1>{id}</h1>
      {proposal && <span class="status">{proposal.status}</span>}
    </header>
    {error && <p class="err">Error: {error}</p>}
    {!error && !proposal && <p class="empty">Proposal no encontrada.</p>}
    {!error && proposal && (
      <div class="body">
        <div class="canvas">
          <ChangeGraph client:only="react" nodes={laidOut.nodes} edges={laidOut.edges} />
        </div>
        <aside class="panel">
          <h2>Informe</h2>
          {narratives.map(n => <p class="narrative">{n}</p>)}
          {counts && (
            <div class="counts">
              <span class="chip" title={historical ? 'contexto reconstruido al instante del commit' : 'contexto en vivo (estado actual del grafo)'}>
                {historical ? '🕓 contexto del commit' : '⟳ contexto actual'}
              </span>
              <span class="chip">{counts.raws} raw</span>
              <span class="chip">+{counts.creates} notas</span>
              <span class="chip">{counts.updates} updates</span>
              <span class="chip">{counts.edges} edges</span>
            </div>
          )}
        </aside>
      </div>
    )}
  </body>
</html>
