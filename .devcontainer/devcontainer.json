{
  "name": "Huygens",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "runServices": ["app", "surrealdb-init", "surrealdb", "huygens-mcp"],
  "workspaceFolder": "/workspace",
  "forwardPorts": [3030, 8000],
  "portsAttributes": {
    "3030": {
      "label": "MCP server",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "SurrealDB",
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "biomejs.biome",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "editor.codeActionsOnSave": {
          "quickfix.biome": "always",
          "source.organizeImports.biome": "always"
        },
        "typescript.tsdk": "node_modules/typescript/lib",
        "biome.lspBin": "./node_modules/.bin/biome",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "always",
            "source.organizeImports.ruff": "always"
          }
        },
        "python.defaultInterpreterPath": "${workspaceFolder}/backend/huygens-worker/.venv/bin/python",
        "python.analysis.typeCheckingMode": "standard"
      }
    }
  },
  "postCreateCommand": "bun install && cd backend/huygens-worker && uv sync",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "remoteEnv": {
    "EDITOR": "cursor"
  },
  "containerEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  }
}
